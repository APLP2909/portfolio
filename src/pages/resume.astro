---
/**
 * Resume page, rendered as real HTML text so it is searchable and accessible.
 * Content lives in src/data/resume.ts (from content-source.md).
 * Template from design-system.md, "Resume", with two changes Aadeel asked for
 * (10 Nov 2026): a SectionRibbon under the head, and this section order:
 * Achievements, Experience, Projects, Skills, Education, Languages.
 * Achievements use the CardGrid so they read first. Prints on white with no
 * controls (bundle.css).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillGroups from '../components/SkillGroups.astro';
import { site } from '../site.config';
import { achievements, education, experience, languages, projects, skills } from '../data/resume';

// One entry per title: WeSwap's two titles become two entries, newest first.
const entries = experience.flatMap((role) =>
  role.positions.map((pos) => ({
    title: pos.title,
    org: role.note ? `${role.company} · ${role.note}` : role.company,
    dates: pos.dates,
    location: role.location,
    bullets: pos.bullets,
  })),
);
const currentRole = entries[0]?.title ?? '';

/** Achievement text starts mid-sentence ("defined the…"); a card needs a capital. */
const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

/** Ribbon order MUST match the section order below. */
const ribbon = [
  { id: 'achievements', label: 'Achievements' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'education', label: 'Education' },
  { id: 'languages', label: 'Languages' },
];
---

<BaseLayout
  title="Resume"
  description="Resume of Aadeel Peerally, Product Director: experience at PVcase, AMBOSS, Delivery Hero, Equals and WeSwap."
  ogImage="/og/resume.png"
>
  <section class="ps-halo" aria-labelledby="resume-heading">
    <div class="ps-container ps-hero__inner">
      <div class="ps-resume__head">
        <div>
          <div class="ps-eyebrow ps-eyebrow--accent">Resume</div>
          <h1 class="ps-display-lg title" id="resume-heading">{currentRole}</h1>
        </div>
        <a class="ps-btn ps-btn--primary" href={site.resumePdf} download>Download PDF</a>
      </div>
    </div>
  </section>

  <div class="ps-container">
    <nav class="ps-ribbon" aria-label="On this page">
      {ribbon.map((r) => <a href={`#${r.id}`}>{r.label}</a>)}
    </nav>

    <section class="ps-section" aria-labelledby="achievements">
      <h2 class="ps-h2 group" id="achievements">Achievements</h2>
      <div class="ps-grid section-body">
        {
          achievements.map((a) => (
            <article class="ps-card">
              <div class="ps-card__index">{a.label}</div>
              <p class="ps-card__text">{sentence(a.text)}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="ps-section" aria-labelledby="experience">
      <h2 class="ps-h2 group" id="experience">Experience</h2>
      {
        entries.map((e) => (
          <article class="ps-entry">
            <div class="ps-entry__when">
              {e.dates}
              <br />
              {e.location}
            </div>
            <div class="ps-entry__what">
              <h3 class="ps-h3">{e.title}</h3>
              <p class="ps-entry__org">{e.org}</p>
              {e.bullets.length > 0 && (
                <ul class="ps-entry__list">
                  {e.bullets.map((b) => (
                    <li>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </section>

    <section class="ps-section" aria-labelledby="projects">
      <h2 class="ps-h2 group" id="projects">Projects</h2>
      {
        projects.map((p) => (
          <article class="ps-entry">
            <div class="ps-entry__when">{p.label}</div>
            <div class="ps-entry__what">
              <h3 class="ps-h3">{p.name}</h3>
              <ul class="ps-entry__list">
                {p.bullets.map((b) => (
                  <li>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>

    <section class="ps-section" aria-labelledby="skills">
      <h2 class="ps-h2 group" id="skills">Skills</h2>
      <div class="section-body">
        <SkillGroups groups={skills} />
      </div>
    </section>

    <section class="ps-section" aria-labelledby="education">
      <h2 class="ps-h2 group" id="education">Education</h2>
      {
        education.map((e) => (
          <article class="ps-entry">
            <div class="ps-entry__when">{e.year}</div>
            <div class="ps-entry__what">
              <h3 class="ps-h3">{e.degree}</h3>
              <p class="ps-entry__org">{e.school}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section class="ps-section" aria-labelledby="languages">
      <h2 class="ps-h2 group" id="languages">Languages</h2>
      <div class="section-body">
        <p>{languages.map((l) => `${l.name} (${l.level})`).join(', ')}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The head sits inside the hero band so it carries the halo like other pages. */
  .ps-resume__head {
    flex: 1 1 100%;
    padding-block: 0;
  }

  .title {
    margin-top: var(--space-3);
  }

  /* Space between a section title and its content (space-5). */
  .group {
    margin-bottom: var(--space-5);
  }

  /*
   * Sections without ResumeEntry rows (Achievements, Skills, Languages) get the
   * same 1px line and top spacing that each entry has (.ps-entry: border-top,
   * 28px padding), so every section reads the same.
   */
  .section-body {
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }

  /* Ribbon links land with breathing room below the page top. */
  section[aria-labelledby] {
    scroll-margin-top: var(--space-4);
  }
</style>
