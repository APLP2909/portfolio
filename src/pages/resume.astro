---
/**
 * Resume page, rendered as real HTML text so it is searchable and accessible.
 * Content lives in src/data/resume.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import EmailLink from '../components/EmailLink.astro';
import { site } from '../site.config';
import { achievements, education, experience, languages, projects, skills } from '../data/resume';
---

<BaseLayout
  title="Resume"
  description="Resume of Aadeel Peerally, Product Director: experience at PVcase, AMBOSS, Delivery Hero, Equals and WeSwap."
  ogImage="/og/resume.png"
>
  <header class="resume-header">
    <h1>Resume</h1>
    <p class="who"><strong>{site.name}</strong> · Product Leader · {site.location}</p>
    <p class="links"><EmailLink>Email</EmailLink> · <a href={site.linkedin} rel="me">LinkedIn</a></p>
    <CallToAction href={site.resumePdf} icon="download" download>Download resume (PDF)</CallToAction>
  </header>

  <section aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    {
      experience.map((role) => (
        <article class="role">
          <h3>
            {role.company}
            {role.note && <span class="note"> · {role.note}</span>}
          </h3>
          <p class="location">{role.location}</p>
          {role.positions.map((pos) => (
            <div class="position">
              <p class="title-line">
                <strong>{pos.title}</strong> · <span>{pos.dates}</span>
              </p>
              {pos.bullets.length > 0 && (
                <ul>
                  {pos.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </article>
      ))
    }
  </section>

  <section aria-labelledby="achievements">
    <h2 id="achievements">Achievements</h2>
    <ul>
      {
        achievements.map((a) => (
          <li>
            <strong>{a.label}:</strong> {a.text}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="education">
    <h2 id="education">Education</h2>
    <ul class="plain">
      {
        education.map((e) => (
          <li>
            <strong>{e.degree}</strong> · {e.school} · {e.year}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="skills">
    <h2 id="skills">Skills</h2>
    <dl class="skills">
      {
        skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="languages">
    <h2 id="languages">Languages</h2>
    <p>{languages.map((l) => `${l.name} (${l.level})`).join(' · ')}</p>
  </section>

  <section aria-labelledby="projects">
    <h2 id="projects">Projects</h2>
    {
      projects.map((p) => (
        <article class="role">
          <h3>
            {p.name} <span class="note">· {p.label}</span>
          </h3>
          <ul>
            {p.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <p class="bottom-cta">
    <CallToAction href={site.resumePdf} icon="download" download>Download resume (PDF)</CallToAction>
  </p>
</BaseLayout>

<style>
  .resume-header {
    margin-block: var(--space-5) var(--space-4);
  }

  .who,
  .links {
    margin-block: var(--space-1);
  }

  .links {
    margin-bottom: var(--space-4);
  }

  section {
    max-width: var(--measure);
    margin-block: var(--space-5);
  }

  h2 {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .role {
    margin-block: var(--space-4);
  }

  .role h3 {
    margin-bottom: 0;
  }

  .note,
  .location {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .location {
    margin: 0;
  }

  .title-line {
    margin-block: var(--space-2) 0;
  }

  .plain {
    list-style: none;
    padding: 0;
  }

  .skills {
    display: grid;
    gap: var(--space-3);
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  .bottom-cta {
    margin-block: var(--space-5);
  }
</style>
