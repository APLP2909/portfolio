---
/** Page not found. Copy approved by Aadeel, 9 November 2026. Hero without a portrait (design-system.md). */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="ps-halo" aria-labelledby="nf-heading">
    <div class="ps-container ps-hero__inner flush-end">
      <div class="ps-hero__text">
        <div class="ps-eyebrow ps-eyebrow--accent">404</div>
        <h1 class="ps-display-lg" id="nf-heading">Page not found</h1>
        <p class="ps-lead">The page you are looking for does not exist or has moved.</p>
        <div class="ps-actions">
          <a class="ps-btn ps-btn--primary" href="/">Go to the home page</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The hero is the last block here, so drop its bottom padding; the page's
     standard gap before the ContactPanel (global.css) then applies alone. */
  .flush-end {
    padding-bottom: 0;
  }
</style>
