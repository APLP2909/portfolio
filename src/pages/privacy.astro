---
/**
 * Privacy page. Copy approved by Aadeel, 9 November 2026.
 * It MUST name the analytics tool and say what it collects. If the analytics
 * set-up changes, update this page in the same commit.
 * Template from design-system.md, "text page": hero without a portrait, then SectionRows.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailLink from '../components/EmailLink.astro';
---

<BaseLayout
  title="Privacy"
  description="How aadeelp.com handles visitor data: Cloudflare Web Analytics, no cookies."
  ogImage="/og/privacy.png"
>
  <section class="ps-halo" aria-labelledby="privacy-heading">
    <div class="ps-container ps-hero__inner">
      <div class="ps-hero__text">
        <div class="ps-eyebrow ps-eyebrow--accent">Privacy</div>
        <h1 class="ps-display-lg" id="privacy-heading">Privacy</h1>
        <p class="ps-lead">This is a personal website. It has no accounts, forms or advertising, and it sets no cookies.</p>
      </div>
    </div>
  </section>

  <div class="ps-container">
    <section class="ps-row" id="analytics">
      <h2 class="ps-h2 ps-row__title">Analytics</h2>
      <div class="ps-row__body">
        <p>
          To understand how many people visit the site and which pages they read, I use{' '}
          <a href="https://www.cloudflare.com/web-analytics/">Cloudflare Web Analytics</a>. It does not use cookies or
          browser storage, and Cloudflare says it does not use your IP address or browser details to identify or
          fingerprint you.
        </p>
        <p>For each page view, it records:</p>
        <ul class="ps-entry__list">
          <li>the page you visited and the site that linked to it, if any</li>
          <li>your country</li>
          <li>your browser, operating system and device type (desktop, mobile or tablet)</li>
          <li>how quickly the page loaded</li>
        </ul>
        <p>
          I see this information only as totals, not per visitor. You can read more in{' '}
          <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare's privacy policy</a>.
        </p>
      </div>
    </section>

    <section class="ps-row" id="hosting">
      <h2 class="ps-h2 ps-row__title">Hosting</h2>
      <div class="ps-row__body">
        <p>
          The site is hosted on GitHub Pages. Like any web server, GitHub may log technical data, such as IP
          addresses, to keep the service running and secure. See{' '}
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            >GitHub's privacy statement</a
          >.
        </p>
      </div>
    </section>

    <section class="ps-row" id="contact-privacy">
      <h2 class="ps-h2 ps-row__title">Contact</h2>
      <div class="ps-row__body">
        <p>
          If you email me, I use your message only to reply. Questions about this page: <EmailLink>email me</EmailLink>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
