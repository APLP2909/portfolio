---
/**
 * /work/: every case study, newest first, or an empty state.
 * Template from design-system.md, "How to add a new area": an index page with
 * a hero without a portrait and a stack of WorkCards.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';
import { getWork } from '../../lib/work';

// The coming-soon line only makes sense under real cards; the empty state has its own wording.
const hasWork = (await getWork()).length > 0;
---

<BaseLayout
  title="My work"
  description="Case studies by Aadeel Peerally on platforms, payments and AI."
  ogImage="/og/work.png"
>
  <section class="ps-halo" aria-labelledby="work-heading">
    <div class="ps-container ps-hero__inner">
      <div class="ps-hero__text">
        <div class="ps-eyebrow ps-eyebrow--accent">Work</div>
        <h1 class="ps-display-lg" id="work-heading">My work</h1>
      </div>
    </div>
  </section>
  <div class="ps-container ps-stack">
    <WorkList headingLevel={2} />
    {
      hasWork && (
        // Copy brief approved 10 November 2026: muted body text, space-5 below the stack, capped at measure.
        <p class="ps-muted ps-measure">
          More case studies are coming soon.
        </p>
      )
    }
  </div>
</BaseLayout>
