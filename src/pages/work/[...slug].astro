---
/**
 * Case-study pages: one per file in src/content/work/.
 * The page body lives in src/components/CaseStudy.astro. The build fails if a
 * case study's sections do not follow the section template (src/lib/work.ts).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { getWork, workSlug, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  const entries = await getWork();
  return entries.map((entry) => ({ params: { slug: workSlug(entry) }, props: { entry } }));
}

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const d = entry.data;
const slug = workSlug(entry);
---

<BaseLayout title={d.title} description={d.description} ogImage={`/og/work/${slug}.png`} ogType="article">
  <CaseStudy entry={entry} />
</BaseLayout>
