---
/**
 * Case-study page template. One page per file in src/content/work/.
 * Template from design-system.md, "Case study": back link, tags, title, lead
 * summary, MediaSlot hero (video or image), then the ContextPanel beside the
 * article. The build fails if a case study's sections do not follow the
 * section template (src/lib/work.ts).
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoopVideo from '../../components/LoopVideo.astro';
import { assertSections, getWork, workSlug, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  const entries = await getWork();
  return entries.map((entry) => ({ params: { slug: workSlug(entry) }, props: { entry } }));
}

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
assertSections(entry, headings);

const d = entry.data;
const slug = workSlug(entry);
// Same labels, same order, on every case study. Team is optional.
const facts: [string, string | undefined][] = [
  ['Role', d.role],
  ['Company', d.company],
  ['Sector', d.sector],
  ['Timeframe', d.timeframe],
  ['Team', d.team],
];
---

<BaseLayout title={d.title} description={d.description} ogImage={`/og/work/${slug}.png`} ogType="article">
  <div class="ps-container">
    <header class="ps-stack head">
      <a class="ps-back" href="/work/">← My work</a>
      <div class="ps-tags">{d.tags.map((tag) => <span class="ps-tag">{tag}</span>)}</div>
      <h1 class="ps-display-xl">{d.title}</h1>
      <p class="ps-lead">{d.description}</p>
    </header>

    {
      (d.video || d.cover) && (
        <div class="hero-media">
          {d.video ? (
            <LoopVideo {...d.video} />
          ) : (
            d.cover && (
              <div class="ps-media">
                <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1280, 1920]} sizes="(min-width: 75rem) 1072px, 100vw" />
              </div>
            )
          )}
        </div>
      )
    }

    <div class="ps-case">
      <aside class="ps-panel" aria-label="Context">
        <dl>
          {
            facts
              .filter(([, value]) => value)
              .map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))
          }
          <div class="ps-panel__outcome">
            <dt>Outcome</dt>
            <dd>{d.outcome}</dd>
          </div>
        </dl>
      </aside>
      <div class="ps-case__article ps-stack article">
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-4) var(--space-7);
  }

  .hero-media {
    margin-bottom: var(--space-7);
  }

  /* Markdown sections render as SectionRow-style blocks: an h2 and paragraphs. */
  .article :global(h2) {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 30px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    padding-top: var(--space-6);
  }

  .article :global(h2:first-child) {
    padding-top: 0;
  }

  .article :global(p),
  .article :global(li) {
    font-size: 18px;
    line-height: 1.65;
  }

  .article :global(ul) {
    padding-left: 1.2em;
    list-style: disc;
  }

  /* Images in the body sit in a media frame: 1px line, radius-lg. */
  .article :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
</style>
