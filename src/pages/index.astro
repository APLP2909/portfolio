---
/** Home page. Copy from copy-home.md (approved 9 November 2026). */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import headshot from '../assets/headshot.jpg';
import CallToAction from '../components/CallToAction.astro';
import Skills from '../components/Skills.astro';
import WorkList from '../components/WorkList.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site } from '../site.config';
import { getWork } from '../lib/work';

const hasWork = (await getWork()).length > 0;
const showWorkButton = hasWork || !site.hideWorkWhenEmpty;

const proof = [
  { number: '€5M+', label: 'saved each year in payment processing costs at Delivery Hero' },
  { number: '20+', label: 'countries migrated onto one financial platform at Delivery Hero' },
  { number: '500+', label: 'monthly active users on PVcase Platform, beyond its pilot goals' },
];

const differentiators = [
  {
    heading: 'The same problem, in different sectors',
    text: 'At Delivery Hero, AMBOSS and PVcase, I led work to bring fragmented systems onto a single platform. Food delivery, health education and solar energy each came with their own constraints. Working across them has shown me how much the right answer depends on context.',
  },
  {
    heading: 'Payments with commercial results',
    text: 'I have led payments products at WeSwap, Equals, Delivery Hero and AMBOSS. The work reduced processing costs, improved payment success rates and recovered orders that previously failed.',
  },
  {
    heading: 'Hands-on AI',
    text: 'At PVcase, we shipped an LLM-powered review workflow that turns expert review into structured compliance checks, with a human in the loop. As a personal project, I built Arnie OS: a system of 10+ AI agents that automates product management workflows.',
  },
  {
    heading: 'Founder experience',
    text: 'I co-founded TryMyKitchen, a self-serve marketplace for cooking classes. It grew to 8,000+ classes across Europe and North America.',
  },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-text">
      <p class="name label">{site.name}</p>
      <h1 id="hero-heading">Product leader for platforms and AI</h1>
      <p class="level">Product Director · 15 years · built and led product teams across four sectors</p>
      <div class="actions">
        {showWorkButton && <CallToAction href="/work/">See my work</CallToAction>}
        <CallToAction href={site.resumePdf} variant="secondary" icon="download" download>Download resume</CallToAction>
      </div>
    </div>
    <Image
      src={headshot}
      alt="Portrait of Aadeel Peerally"
      width={640}
      widths={[160, 320, 480, 640]}
      sizes="(min-width: 48rem) 320px, 160px"
      class="portrait"
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <section aria-label="Highlights">
    <ul class="proof">
      {
        proof.map((p) => (
          <li>
            <strong>{p.number}</strong>
            <span>{p.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="prose narrative ruled" aria-label="Summary">
    <p>
      Fast-growing companies often end up with fragmented systems: separate tools, separate data and separate ways
      of handling payments. Much of my career has been spent helping to bring these together into platforms that can
      grow with the business.
    </p>
    <p>
      I have worked on this problem in fintech, marketplaces, health education and solar energy. Each company
      approached it differently, and each one taught me something new about what works. Most recently, at PVcase, I
      led the product strategy for a new platform that unites solar engineering and commercial workflows.
    </p>
  </section>

  <section class="ruled" aria-labelledby="bring-heading">
    <h2 id="bring-heading">What I bring</h2>
    <div class="bring">
      {
        differentiators.map((d) => (
          <div>
            <h3>{d.heading}</h3>
            <p>{d.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="ruled" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <Skills />
  </section>

  <section id="work" class="ruled" aria-labelledby="work-heading">
    <h2 id="work-heading">My work</h2>
    <WorkList />
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  section {
    margin-block: var(--space-5);
  }

  .hero {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .portrait {
    order: -1;
    width: 8rem;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 25%;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr 17.5rem;
      align-items: end;
      gap: var(--space-5);
    }

    .portrait {
      order: 0;
      width: 100%;
      aspect-ratio: 4 / 5;
      border-bottom: 4px solid var(--color-charge-dim);
    }
  }

  .name {
    margin: 0;
  }

  h1 {
    font-size: clamp(2.25rem, 6.5vw, 4rem);
    margin-block: var(--space-3);
  }

  .level {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-top: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
   * The proof numbers are the strongest evidence on the page, so they are the
   * only things that glow (Charge State: "brightness equals rank").
   */
  .proof li {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4);
    padding-top: calc(var(--space-4) + 4px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--glow-charge);
  }

  /* The charge bar: fills once on load, the site's one "energy" moment. */
  .proof li::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 4px;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--color-charge);
    box-shadow: var(--glow-text);
    transform-origin: left;
    animation: charge var(--t-charge) both;
  }

  .proof li:nth-child(2)::before {
    animation-delay: 60ms;
  }

  .proof li:nth-child(3)::before {
    animation-delay: 120ms;
  }

  @keyframes charge {
    from {
      transform: scaleX(0);
    }
  }

  .proof strong {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-charge);
    text-shadow: var(--glow-text);
  }

  .proof span {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .bring {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-2) var(--space-5);
  }

  h2 {
    margin-top: 0;
    font-size: 1.75rem;
  }

  .bring h3 {
    margin-bottom: var(--space-2);
    font-size: 1.125rem;
  }

  .bring p {
    margin-top: 0;
  }
</style>
