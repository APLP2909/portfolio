---
/**
 * Home page. Copy from copy-home.md (approved 9 November 2026); hero, proof
 * strip and cards updated from the copy brief approved 10 November 2026.
 * Template from design-system.md, "Home": Hero, StatStrip, CardGrid,
 * WorkCard, SkillGroups, then the ContactPanel and Footer from the layout.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import headshot from '../assets/headshot.jpg';
import SkillGroups from '../components/SkillGroups.astro';
import WorkList from '../components/WorkList.astro';
import { site } from '../site.config';
import { getWork } from '../lib/work';

const hasWork = (await getWork()).length > 0;
const showWorkButton = hasWork || !site.hideWorkWhenEmpty;

const proof = [
  {
    value: '500+',
    label:
      'monthly active users on the system of record I created for PVcase, with month-1 retention doubled from its pilot low',
  },
  { value: '€5M+', label: 'saved each year in payment processing costs at Delivery Hero' },
  { value: '30%+', label: 'higher purchase-path conversion at AMBOSS' },
];

const cards = [
  {
    title: 'Platforms in fintech, marketplaces and energy',
    text: 'Moved 20+ countries onto one financial platform at Delivery Hero and brought AMBOSS payments into one system. At PVcase I lead the platform that connects four products around one project record.',
  },
  {
    title: 'Payments with commercial results',
    text: 'Cut payment processing costs by €5M+ a year at Delivery Hero and by nearly 50% at AMBOSS, with better success rates and recovered orders. Cut platform fraud by over 90% at WeSwap.',
  },
  {
    title: 'Hands-on AI',
    text: 'Released an LLM review workflow at PVcase where a person approves every finding. Built Arnie OS, 10+ AI agents that my Senior PMs use for research, PRDs and reporting.',
  },
  {
    title: 'Decisions from evidence',
    text: 'When retention on PVcase Platform stayed low, I stopped work on notifications and business-development packages and interviewed customers. What they did with their project documents led to AI-Assisted Design Review.',
  },
  {
    title: 'Founder experience',
    text: 'Co-founded TryMyKitchen, which grew to 8,000+ classes across Europe and North America.',
  },
];

// copy-home.md, "Skills": each comma-separated item becomes a chip.
const split = (s: string) => s.split(', ');
const skills = [
  {
    group: 'Product leadership',
    items: split(
      'product strategy, platform strategy, product vision, product organisation design, team building and coaching, discovery, roadmapping, operating cadence',
    ),
  },
  {
    group: 'Technology',
    items: split(
      'AI and LLM products, agentic workflows, workflow automation, platform architecture, APIs, data products, integrations, analytics',
    ),
  },
  {
    group: 'Commercial',
    items: split('B2B SaaS, marketplace economics, payments, cost optimisation, growth'),
  },
];
---

<BaseLayout>
  <section class="ps-halo" aria-labelledby="hero-heading">
    <div class="ps-container ps-hero__inner">
      <div class="ps-hero__text">
        <div class="ps-eyebrow ps-eyebrow--accent">Hello, I am</div>
        <h1 class="ps-display-xl ps-name" id="hero-heading">{site.name}</h1>
        <p class="ps-tagline">Product Leader. I build platforms, payments and AI products.</p>
        <p class="ps-lead">
          15 years in product across four sectors. Hands-on: I launch products from zero to one and build with AI
          myself. Based in Berlin.
        </p>
        <div class="ps-actions">
          {showWorkButton && <a class="ps-btn ps-btn--primary" href="/work/">See my work</a>}
          <a class="ps-btn ps-btn--secondary" href={site.resumePdf} download>Download resume</a>
        </div>
      </div>
      <div class="ps-hero__media">
        <div class="ps-portrait">
          <Image
            src={headshot}
            alt="Portrait of Aadeel Peerally"
            width={520}
            widths={[260, 520]}
            sizes="(min-width: 60rem) 260px, 190px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="ps-container" aria-label="Highlights">
    <div class="ps-stats">
      {
        proof.map((p) => (
          <div class="ps-stat">
            <div class="ps-stat__value">{p.value}</div>
            <p class="ps-stat__label">{p.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="ps-section ps-container" aria-labelledby="bring-heading">
    <h2 class="ps-h2" id="bring-heading">What I bring</h2>
    <div class="ps-grid ps-grid--balanced spaced">
      {
        cards.map((c, i) => (
          <article class="ps-card">
            <div class="ps-card__index">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="ps-h3 ps-card__title">{c.title}</h3>
            <p class="ps-card__text">{c.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ps-section ps-container" id="work" aria-labelledby="work-heading">
    <h2 class="ps-h2" id="work-heading">My work</h2>
    <div class="spaced">
      <WorkList />
    </div>
  </section>

  <section class="ps-section ps-container" aria-labelledby="skills-heading">
    <h2 class="ps-h2" id="skills-heading">Skills</h2>
    <div class="spaced">
      <SkillGroups groups={skills} />
    </div>
  </section>
</BaseLayout>

<style>
  /* Space between a section title and its content (space-5). */
  .spaced {
    margin-top: var(--space-5);
  }
</style>
