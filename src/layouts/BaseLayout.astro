---
/**
 * Shared page shell (design-system.md, "Page templates"): every page starts
 * with the Header and ends with the ContactPanel and the Footer.
 */
import '../styles/global.css';
import type { ComponentProps } from 'astro/types';
import MainHead from '../components/MainHead.astro';
import Header from '../components/Header.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Footer from '../components/Footer.astro';

type Props = ComponentProps<typeof MainHead>;

const props = Astro.props;
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <MainHead {...props} />
  </head>
  <body class="ps-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ps-container">
      <Header />
    </div>
    <main id="main">
      <slot />
    </main>
    <div class="ps-container">
      <ContactPanel />
      <Footer />
    </div>
  </body>
</html>
