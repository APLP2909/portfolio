---
/** Site header: name, main navigation and the theme toggle. */
import { navItems, site } from '../site.config';
import { getWork } from '../lib/work';
import ThemeToggle from './ThemeToggle.astro';

const hasWork = (await getWork()).length > 0;
const items = navItems.filter((item) => !(item.requiresWork && site.hideWorkWhenEmpty && !hasWork));
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="name" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .name {
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    margin-right: auto;
  }

  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-2);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 30rem) {
    nav {
      order: 3;
      width: 100%;
    }
  }
</style>
