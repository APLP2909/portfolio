---
/**
 * Site header: AP monogram (links home), main navigation and the theme toggle.
 * The full name appears once per page elsewhere (the H1 on Home), not here.
 */
import { navItems, site } from '../site.config';
import { getWork } from '../lib/work';
import ThemeToggle from './ThemeToggle.astro';

const hasWork = (await getWork()).length > 0;
const items = navItems.filter((item) => !(item.requiresWork && site.hideWorkWhenEmpty && !hasWork));
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="monogram" href="/" aria-label={`${site.name}, home`}>AP</a>
    <nav aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  /* Plain monogram with a 1px border (design rules, 9 November 2026). */
  .monogram {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding-inline: var(--space-2);
    margin-right: auto;
    border: 1px solid var(--color-text);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    border-bottom-color: var(--color-border);
  }

  nav a[aria-current='page'] {
    border-bottom-color: var(--color-text);
  }

  @media (max-width: 30rem) {
    nav {
      order: 3;
      width: 100%;
    }
  }
</style>
