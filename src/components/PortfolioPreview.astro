---
/**
 * Card for one case study. Used on the home page and /work/.
 * Media slot: the case study's demo video if it has one, otherwise its cover image.
 */
import { Image } from 'astro:assets';
import Pill from './Pill.astro';
import LoopVideo from './LoopVideo.astro';
import { workSlug, type WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
  /** Heading level for the card title, so the page outline stays correct. */
  headingLevel?: 2 | 3;
}

const { entry, headingLevel = 3 } = Astro.props;
const { title, description, company, timeframe, outcome, tags, cover, coverAlt, video } = entry.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
  {
    video ? (
      <div class="media">
        <LoopVideo {...video} caption={undefined} />
      </div>
    ) : (
      cover && (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 800]}
          sizes="(min-width: 48rem) 400px, 100vw"
          class="cover"
        />
      )
    )
  }
  <div class="body">
    <p class="meta label">{company} · {timeframe}</p>
    <Heading class="title"><a href={`/work/${workSlug(entry)}/`}>{title}</a></Heading>
    <p>{description}</p>
    <p class="outcome"><span class="label">Outcome</span> {outcome}</p>
    <ul class="tags" aria-label="Tags">
      {
        tags.map((tag) => (
          <li>
            <Pill>{tag}</Pill>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    height: 100%;
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-charge-dim);
    transition: border-color var(--t-base);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg);
  }

  .card:hover {
    border-top-color: var(--color-charge);
  }

  .cover {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }

  .media :global(.loop-video) {
    margin: 0;
  }

  .media :global(video) {
    border: 0;
    border-radius: 0;
  }

  /* Keep the video's pause button above the card-wide link. */
  .media :global(.toggle) {
    z-index: 1;
  }

  .outcome {
    margin-block: 0 var(--space-3);
  }

  .outcome .label {
    margin-right: var(--space-2);
  }

  .body {
    padding: var(--space-4);
  }

  .meta {
    margin: 0;
  }

  .title a {
    color: var(--color-text);
  }

  .title {
    margin-block: var(--space-2);
    font-size: 1.25rem;
  }

  /* The whole card is clickable; the link text stays the title. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:focus-within {
    outline: 3px solid var(--color-attn);
    outline-offset: 2px;
  }

  .title a:focus-visible {
    outline: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
