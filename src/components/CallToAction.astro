---
/** Link styled as a button. `primary` is the filled style, `secondary` the outlined one. */
import Icon from './Icon.astro';
import type { IconName } from './IconPaths';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  icon?: IconName;
  /** Adds the `download` attribute, so browsers save the file instead of opening it. */
  download?: boolean;
  rel?: string;
}

const { href, variant = 'primary', icon, download = false, rel } = Astro.props;
---

<a class:list={['cta', 'state-layer', variant]} href={href} download={download || undefined} rel={rel}>
  {icon && <Icon name={icon} size={18} />}
  <span><slot /></span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    /* --color-text-muted keeps the outline above 3:1 against the page in both themes. */
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
  }

  .primary {
    background: var(--color-charge);
    border-color: var(--color-charge);
    color: var(--color-on-charge);
  }

  .secondary {
    background: transparent;
    color: var(--color-text);
  }

  .cta:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
