---
/**
 * Everything inside <head>: title, description, canonical URL, social
 * preview tags, favicons and the theme script that runs before first paint.
 */
import { site } from '../site.config';
import { Font } from 'astro:assets';
import Analytics from './Analytics.astro';

interface Props {
  /** Page title. Omit on the home page to use the default title. */
  title?: string;
  description?: string;
  /** Path of this page's social preview image, for example `/og/about.png`. */
  ogImage?: string;
  /** `article` for case studies, `website` for everything else. */
  ogType?: 'website' | 'article';
  /** Set on pages search engines should skip, such as the 404 page. */
  noindex?: boolean;
}

const {
  title,
  description = site.defaultDescription,
  ogImage = '/og/home.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<Font cssVariable="--font-plex-sans" preload={[{ weight: 400, style: 'normal' }, { weight: 700 }]} />
<Font cssVariable="--font-plex-mono" />
<Font cssVariable="--font-archivo" preload />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/favicon-180.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script is:inline>
  // Runs before first paint, so the page never flashes the wrong theme.
  // Dark is the default (design-system.md); a stored choice wins.
  (() => {
    let theme = null;
    try {
      theme = localStorage.getItem('theme');
    } catch {}
    document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
  })();
</script>

<Analytics />
