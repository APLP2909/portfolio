---
/**
 * An image that opens full size when clicked or tapped (approved by Aadeel,
 * 10 November 2026). Uses the browser's built-in <dialog>: it traps focus,
 * closes with Esc, and the "Close" button or a click outside the image also
 * closes it. Without JavaScript the image simply shows at its in-page size.
 *
 * Place it inside a MediaSlot (`.ps-media`); it fills the slot like a plain image.
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, widths, sizes, loading = 'lazy', fetchpriority } = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' });
---

<button type="button" class="zoom" data-zoom aria-label={`Enlarge image: ${alt}`}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} />
</button>
<dialog class="zoom-dialog" aria-label={alt}>
  <img src={full.src} alt={alt} width={full.attributes.width} height={full.attributes.height} loading="lazy" />
  <form method="dialog">
    <button class="ps-btn ps-btn--secondary ps-btn--sm zoom-close">Close</button>
  </form>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
    const dialog = button.nextElementSibling;
    if (!(dialog instanceof HTMLDialogElement)) return;
    button.addEventListener('click', () => dialog.showModal());
    // A click on the backdrop (outside the image and button) closes the dialog.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .zoom :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zoom:focus-visible {
    outline: 2px solid var(--attn);
    outline-offset: -2px;
  }

  .zoom-dialog {
    max-width: min(1600px, 94vw);
    max-height: 94vh;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
  }

  .zoom-dialog::backdrop {
    background: color-mix(in srgb, var(--bg) 85%, transparent);
  }

  .zoom-dialog img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(94vh - 120px);
    border-radius: var(--radius-md);
  }

  .zoom-dialog form {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-3);
  }
</style>
