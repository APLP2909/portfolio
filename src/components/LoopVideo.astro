---
/**
 * Silent looping demo video inside a MediaSlot (design-system.md), with a
 * pause control.
 *
 * - `muted`, `loop`, `playsinline` and `aria-label`, as the MediaSlot rules require.
 * - Never autoplays when the visitor has asked for reduced motion; they see
 *   the poster and can press Play.
 * - Pauses while scrolled out of view, to save battery and data.
 * - Without JavaScript, the browser's own controls appear instead.
 * - The control is a text button ("Pause" / "Play"): the system has no icon set.
 *
 * Files live in `public/videos/`. Use MP4 (H.264), no audio track.
 */

interface Props {
  /** For example `/videos/pvcase-platform-demo.mp4`. */
  src: string;
  /** For example `/videos/pvcase-platform-demo-poster.jpg`. */
  poster: string;
  width: number;
  height: number;
  /** What the video shows, for screen readers. */
  label: string;
  caption?: string | undefined;
  /** Extra classes for the slot, such as `ps-media--4x3`. */
  class?: string;
}

const { src, poster, width, height, label, caption, class: className } = Astro.props;
---

<figure class="loop-video" data-loop-video>
  <div class:list={['ps-media', 'frame', className]}>
    <video
      src={src}
      poster={poster}
      width={width}
      height={height}
      muted
      loop
      playsinline
      preload="none"
      controls
      aria-label={label}></video>
    <button type="button" class="ps-btn ps-btn--secondary ps-btn--sm toggle" hidden>Play</button>
  </div>
  {caption && <figcaption class="ps-muted">{caption}</figcaption>}
</figure>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-loop-video]').forEach((figure) => {
    const video = figure.querySelector('video');
    const button = figure.querySelector<HTMLButtonElement>('.toggle');
    if (!video || !button) return;

    // JavaScript is running, so swap the native controls for the text button.
    video.controls = false;
    video.muted = true; // Browsers only allow autoplay for muted video.
    button.hidden = false;

    /** True once the visitor has pressed Pause; we then never resume on our own. */
    let userPaused = false;

    const sync = () => {
      button.textContent = video.paused ? 'Play' : 'Pause';
    };

    const tryPlay = () => {
      video.play().catch(() => sync());
    };

    button.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        tryPlay();
      } else {
        userPaused = true;
        video.pause();
      }
    });

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);

    new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) {
          video.pause();
        } else if (!userPaused && !reduceMotion.matches) {
          tryPlay();
        }
      },
      { threshold: 0.25 },
    ).observe(video);

    sync();
  });
</script>

<style>
  .loop-video {
    margin: 0;
  }

  .frame {
    position: relative;
  }

  /* The control sits in the corner of the slot, on a solid ground (no text over media). */
  .toggle {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    background: var(--surface);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: 15px;
  }
</style>
