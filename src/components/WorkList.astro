---
/**
 * Every case study as a WorkCard, newest first, stacked with a 24px gap.
 * Shows an empty state when there are none, so the live site never shows a
 * blank block.
 */
import WorkCard from './WorkCard.astro';
import { getWork } from '../lib/work';

interface Props {
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const entries = await getWork();
---

{
  entries.length > 0 ? (
    <div class="stack">
      {entries.map((entry) => (
        <WorkCard entry={entry} headingLevel={headingLevel} />
      ))}
    </div>
  ) : (
    <div class="ps-card">
      {/* Empty-state copy approved by Aadeel, 9 November 2026. */}
      <p class="ps-card__text">
        Case studies are being written and will appear here soon. In the meantime, my <a href="/resume/">resume</a>{' '}
        covers my experience in full.
      </p>
    </div>
  )
}

<style>
  .stack {
    display: grid;
    gap: var(--space-5);
  }

  .ps-card__text {
    margin-top: 0;
  }
</style>
