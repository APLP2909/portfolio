---
/**
 * Case-study page body. Template from design-system.md, "Case study", with two
 * changes Aadeel approved on 10 November 2026:
 * - a split hero: title and summary beside the hero media;
 * - the context facts as one horizontal strip under the hero instead of a
 *   sidebar, so the article and its feature rows can use the full width.
 * Story text stays at the reading measure (720px); FeatureRows run full width
 * with the screenshot taking about 60% of the row. Below 768px the facts form a
 * two-column grid, and each screenshot sits above its paragraph.
 */
import { render } from 'astro:content';
import LoopVideo from './LoopVideo.astro';
import Zoomable from './Zoomable.astro';
import { assertSections, type WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
assertSections(entry, headings);

const d = entry.data;
// Same labels, same order, on every case study. Team is optional.
const facts: [string, string | undefined][] = [
  ['Role', d.role],
  ['Company', d.company],
  ['Sector', d.sector],
  ['Timeframe', d.timeframe],
  ['Team', d.team],
];
const shownFacts = facts.filter(([, value]) => value) as [string, string][];
---

<section class="ps-halo" aria-labelledby="case-heading">
  <div class="ps-container ps-hero__inner">
    <header class="ps-hero__text">
      <a class="ps-back" href="/work/">← My work</a>
      <div class="ps-tags">{d.tags.map((tag) => <span class="ps-tag">{tag}</span>)}</div>
      <h1 class="ps-display-lg case-title" id="case-heading">{d.title}</h1>
      <p class="ps-lead">{d.description}</p>
    </header>
    {
      (d.video || d.cover) && (
        <div class="case-hero__media">
          {d.video ? (
            <LoopVideo {...d.video} class="ps-media--4x3" />
          ) : (
            d.cover && (
              <div class="ps-media ps-media--4x3">
                <Zoomable
                  src={d.cover}
                  alt={d.coverAlt ?? ''}
                  widths={[480, 720, 1080, 1440]}
                  sizes="(min-width: 64rem) 540px, (min-width: 45rem) 720px, 100vw"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            )
          )}
        </div>
      )
    }
  </div>
</section>

<div class="ps-container">
  <dl class="facts-strip" aria-label="Context">
    {
      shownFacts.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
    <div class="facts-strip__outcome">
      <dt>Outcome</dt>
      <dd>{d.outcome}</dd>
    </div>
  </dl>
  <div class="ps-stack article">
    <Content />
  </div>
</div>

<style>
  /* In the split hero the title has half the width, so it uses display-lg
     (the About headline size) instead of display-xl, and a bolder weight. */
  .case-title {
    font-weight: 700;
  }

  /*
   * Split hero (Aadeel, 10 Nov 2026): the system Hero pattern with the case
   * study's media in place of the portrait. Text and media wrap when there is
   * not room for both; the media then sits under the text, capped at the
   * reading measure. The 4:3 frame is close to a product screenshot's shape,
   * and anchoring the crop top-left keeps the app's top bar and side rail.
   */
  .case-hero__media {
    flex: 1 1 420px;
    min-width: 0;
    max-width: var(--measure);
  }

  .case-hero__media :global(img) {
    object-position: 0 0;
  }

  /* Markdown sections render as SectionRow-style blocks: an h2 and paragraphs. */
  .article :global(h2) {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 30px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    padding-top: var(--space-6);
  }

  .article :global(h2:first-child) {
    padding-top: 0;
  }

  .article :global(p),
  .article :global(li) {
    font-size: 18px;
    line-height: 1.65;
  }

  .article :global(ul) {
    padding-left: 1.2em;
    list-style: disc;
  }

  /* Plain Markdown images (inside a paragraph) get a media frame. Images in
     MediaSlots are styled by the system and must not be touched here. */
  .article :global(p > img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  /* ---- Facts strip ---- */
  .facts-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
    margin: 0 0 var(--space-7);
    padding-block: var(--space-5);
    border-block: 1px solid var(--line);
  }

  .facts-strip dt {
    font: 500 11.5px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts-strip dd {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.45;
    overflow-wrap: break-word;
  }

  .facts-strip__outcome dd {
    font: 500 15px/1.45 var(--font-mono);
    color: var(--accent);
  }

  /*
   * From 1024px all facts share ONE row with EQUAL visible gaps (Aadeel,
   * 10 Nov 2026). Long values wrap inside their fact, which normally leaves
   * empty space at the end of their lines; the script below trims each fact
   * to its longest line, and `space-between` then shares the leftover width
   * equally between the facts. Below 1024px the facts use the two-column grid.
   */
  @media (min-width: 64rem) {
    .facts-strip {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 32px;
    }

    .facts-strip > div {
      flex: 0 1 auto;
      min-width: 0;
    }
  }

  /* Story text stays at the reading measure; feature rows use the full width. */
  .article > :global(:not(.ps-feature)) {
    max-width: var(--measure);
  }
</style>

<script>
  /**
   * Trims each fact in the facts strip to the width of its longest text line,
   * so the strip's `justify-content: space-between` gives equal visible gaps.
   * Runs on load and whenever the strip changes width. Only acts from 1024px,
   * where the strip is a single row.
   */
  const strip = document.querySelector<HTMLElement>('.facts-strip');
  const wide = window.matchMedia('(min-width: 64rem)');

  const longestLine = (el: HTMLElement) => {
    let max = 0;
    const left = el.getBoundingClientRect().left;
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
      if (!node.textContent?.trim()) continue;
      const range = document.createRange();
      range.selectNodeContents(node);
      for (const rect of range.getClientRects()) max = Math.max(max, rect.right - left);
    }
    return Math.ceil(max) + 1;
  };

  /** Width a fact needs to sit on one line. */
  const naturalWidth = (el: HTMLElement) => {
    // Measure with the row's squeezing switched off, or the width comes out short.
    el.style.flex = 'none';
    el.style.whiteSpace = 'nowrap';
    el.style.width = 'max-content';
    const w = Math.ceil(el.getBoundingClientRect().width);
    el.style.flex = '';
    el.style.whiteSpace = '';
    el.style.width = '';
    return w;
  };

  const fit = () => {
    if (!strip) return;
    const facts = [...strip.children] as HTMLElement[];
    facts.forEach((f) => {
      f.style.flex = '';
      f.style.width = '';
    });
    if (!wide.matches) return;

    // 1. Share the row fairly: short facts keep their one-line width; the long
    //    ones are capped at one common width (c) so that everything fits.
    const gap = parseFloat(getComputedStyle(strip).columnGap) || 0;
    const available = strip.clientWidth - gap * (facts.length - 1);
    const natural = facts.map(naturalWidth);
    let cap = available / facts.length;
    for (let i = 0; i < facts.length; i++) {
      const short = natural.filter((w) => w <= cap);
      const longCount = facts.length - short.length;
      if (!longCount) break;
      cap = (available - short.reduce((sum, w) => sum + w, 0)) / longCount;
    }
    facts.forEach((f, i) => {
      f.style.flex = '0 0 auto';
      f.style.width = `${Math.floor(Math.min(natural[i] ?? 0, cap))}px`;
    });

    // 2. Trim each fact to its longest wrapped line, so space-between shares
    //    the leftover width as equal gaps.
    const widths = facts.map(longestLine);
    facts.forEach((f, i) => {
      f.style.width = `${widths[i]}px`;
    });
  };

  if (strip) {
    let lastWidth = 0;
    new ResizeObserver(([entry]) => {
      const width = Math.round(entry?.contentRect.width ?? 0);
      if (width !== lastWidth) {
        lastWidth = width;
        fit();
      }
    }).observe(strip);
    document.fonts?.ready.then(fit);
  }
</script>
