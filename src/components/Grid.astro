---
/** Responsive grid: one column on phones, more as space allows. */
interface Props {
  /** Smallest column width before the grid drops a column. */
  min?: string;
  as?: 'div' | 'ul';
}

const { min = '18rem', as: Tag = 'div' } = Astro.props;
---

<Tag class="grid" style={`--grid-min: ${min}`}><slot /></Tag>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--grid-min), 100%), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
