---
/**
 * Theme switch. The design system has no icon set, so the control is a text
 * button naming the theme it switches to ("Light" or "Dark"), styled like a
 * nav link. It stores the choice in localStorage. Dark is the default; the
 * first-paint logic lives in MainHead.astro.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle>
  <span data-theme-label>Light</span><span class="visually-hidden"> theme</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = button?.querySelector<HTMLElement>('[data-theme-label]');
  const root = document.documentElement;

  const sync = () => {
    if (label) label.textContent = root.dataset.theme === 'light' ? 'Dark' : 'Light';
  };

  sync();
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be blocked; the switch still works for this page view.
    }
    sync();
  });
</script>

<style>
  /* Matches .ps-nav links: muted text, accent on hover. Tokens only. */
  .theme-toggle {
    min-height: var(--tap-min);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.12s;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--attn);
    outline-offset: 3px;
  }

  @media print {
    .theme-toggle {
      display: none;
    }
  }
</style>
