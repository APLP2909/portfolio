---
/** Skills block on the home page. Copy from copy-home.md (approved 9 November 2026). */
const groups = [
  {
    name: 'Product leadership',
    items:
      'product strategy, platform strategy, product vision, product organisation design, team building and coaching, discovery, roadmapping, operating cadence',
  },
  {
    name: 'Technology',
    items:
      'AI and LLM products, agentic workflows, workflow automation, platform architecture, APIs, data products, integrations, analytics',
  },
  {
    name: 'Commercial',
    items: 'B2B SaaS, marketplace economics, payments, cost optimisation, growth',
  },
];
---

<dl class="skills">
  {
    groups.map((g) => (
      <div>
        <dt>{g.name}</dt>
        <dd>{g.items}</dd>
      </div>
    ))
  }
</dl>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .skills > div {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  dd {
    margin: 0;
  }
</style>
