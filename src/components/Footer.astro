---
/** Site footer: location and the privacy page link (copy-home.md: "Berlin · Privacy"). */
import { site } from '../site.config';
---

<footer class="site-footer">
  <div class="container row">
    <p>{site.location} · <a href="/privacy/">Privacy</a></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule-strong);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a,
  :global(.site-footer .email-link) {
    color: var(--color-text-muted);
  }
</style>
