---
/**
 * WorkCard (design-system.md): a case-study teaser generated from the case
 * study's frontmatter. Media on one side (the demo video if the case study has
 * one, otherwise its cover image), summary on the other. The only element
 * that uses the `glow` shadow. A cover with a `coverLight` version shows the
 * one that matches the theme. Cover images are shown whole, never cropped.
 */
import { Image } from 'astro:assets';
import LoopVideo from './LoopVideo.astro';
import { workSlug, type WorkEntry } from '../lib/work';

interface Props {
  entry: WorkEntry;
  /** Heading level for the card title, so the page outline stays correct. */
  headingLevel?: 2 | 3;
}

const { entry, headingLevel = 3 } = Astro.props;
const { title, description, outcome, tags, cover, coverLight, coverAlt, video } = entry.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = `/work/${workSlug(entry)}/`;
const hasMedia = Boolean(video || cover);
---

<article class="ps-work">
  {
    hasMedia && (
      <div class="ps-work__media">
        {video ? (
          <LoopVideo {...video} caption={undefined} />
        ) : (
          cover && (
            <>
              <Image
                src={cover}
                alt={coverAlt ?? ''}
                widths={[420, 840]}
                sizes="(min-width: 60rem) 560px, 100vw"
                class:list={{ 'ps-theme--dark': coverLight }}
              />
              {coverLight && (
                <Image
                  src={coverLight}
                  alt={coverAlt ?? ''}
                  widths={[420, 840]}
                  sizes="(min-width: 60rem) 560px, 100vw"
                  loading="lazy"
                  class="ps-theme--light"
                />
              )}
            </>
          )
        )}
      </div>
    )
  }
  <div class="ps-work__body">
    <div class="ps-tags">{tags.slice(0, 3).map((tag) => <span class="ps-tag">{tag}</span>)}</div>
    <Heading class="ps-h2 ps-work__title">{title}</Heading>
    <p>{description}</p>
    <div class="ps-work__meta">{outcome}</div>
    <a class="ps-work__link" href={href}>Read the case study →<span class="visually-hidden">: {title}</span></a>
  </div>
</article>

<style>
  /* The media fills its half; the video's own frame is not needed inside it. */
  .ps-work__media {
    padding: 0;
  }

  /*
   * Cover images are never cropped (Aadeel, 17 November 2026). The media half
   * takes its height from the text beside it, so its shape changes with the
   * screen width. The image keeps its own ratio, centred, and any leftover
   * space shows the page ground, which matches the screenshots' own ground.
   */
  .ps-work__media:has(> img) {
    background: var(--bg);
  }

  .ps-work__media > :global(img) {
    height: auto;
    object-fit: contain;
  }

  .ps-work__media :global(.loop-video),
  .ps-work__media :global(.ps-media) {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
  }
</style>
